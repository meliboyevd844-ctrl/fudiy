# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Main Admin Telegram User ID (numeric ID, e.g. 123456789)
ADMIN_ID=

# Admin Master Password for accessing Admin panel from bot
ADMIN_PASSWORD=admin123

# Shop Geolocation (Default coordinates - can be updated via Admin Panel)
# Example: Tashkent Chorsu / Shop location
SHOP_LATITUDE=41.311081
SHOP_LONGITUDE=69.240562

# Allowed Distance Radius in meters (Default: 50 meters)
SHOP_RADIUS_METERS=50

# Work Hours Configuration
WORK_START_TIME=09:00
WORK_END_TIME=18:00
LATE_GRACE_MINUTES=15

# WebApp URL / Host Configuration (If running locally or ngrok/public domain)
# For local testing inside LAN or with tunneling (e.g. ngrok / localtunnel / VPS IP)
WEBAPP_PORT=8080
WEBAPP_HOST=0.0.0.0
WEBAPP_BASE_URL=http://localhost:8080
